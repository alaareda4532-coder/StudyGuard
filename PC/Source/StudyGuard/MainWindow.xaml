
<Window x:Class="StudyGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyGuard - منظم وقتك"
        Icon="/StudyGuard;component/Gemini_Generated_Image_vyotp1vyotp1vyot.ico"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#10131B"
        Foreground="#F4F6FC"
        FontFamily="Tahoma"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#151925"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1B2030"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303747"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AAB4CA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6878FF"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB4CA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#242B40"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#303958"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B2030"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#303958"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#293052"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LightComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E7EAF0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE3EC"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="245"/>
        </Grid.ColumnDefinitions>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Column="0">

            <!-- الرئيسية -->
            <ScrollViewer x:Name="HomePage"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30">

                    <TextBlock Text="الرئيسية"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="نظرة عامة على وقتك وجدولك"
                               Foreground="#AAB4CA"
                               Margin="0,8,0,24"/>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="أهلًا بك في StudyGuard" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="نظّم يومك وخلي كل وقت له وضعه." Foreground="#AAB4CA"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="HomeDateText" Foreground="#AAB4CA" Margin="0,18,0,5"/>
                                    <TextBlock x:Name="HomeTodaySummary" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Image Grid.Column="1" Source="/StudyGuard;component/Gemini_Generated_Image_vyotp1vyotp1vyot.jfif"
                                       Width="110" Height="110" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>

                            <Border Background="#151925" CornerRadius="12" Padding="16" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="أنت الآن في" Foreground="#AAB4CA" FontSize="13"/>
                                    <TextBlock x:Name="HomeCurrentActivityText" Text="لا يوجد نشاط جارٍ" FontSize="22"
                                               FontWeight="Bold" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="HomeCurrentTimeText" Foreground="#AAB4CA" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="HomeTimeRemainingText" Foreground="#76E3D0" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <Border Height="1" Background="#303747" Margin="0,14,0,12"/>
                                    <TextBlock Text="حالة المسموح والممنوع" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="HomeRestrictionSummaryText" Foreground="#AAB4CA"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="HomeBlockedSummaryText" Foreground="#FFB5C2"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="HomeNextActivity" Foreground="#AAB4CA"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="أوضاع الاستخدام"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <UniformGrid Columns="2" Margin="0,0,0,24">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="☾" FontSize="28" Foreground="#D9A8FF"/>
                                <TextBlock Text="وضع النوم" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBlock Text="وقت الراحة الليلية" Style="{StaticResource SmallLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="▣" FontSize="28" Foreground="#76E3D0"/>
                                <TextBlock Text="وضع الدراسة" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBlock Text="وقت التركيز والتعلّم" Style="{StaticResource SmallLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="☕" FontSize="28" Foreground="#FFD080"/>
                                <TextBlock Text="وضع الاستراحة" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBlock Text="فترات الراحة" Style="{StaticResource SmallLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="◇" FontSize="28" Foreground="#94B9FF"/>
                                <TextBlock Text="الاستخدام الحر" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBlock Text="استخدام الكمبيوتر" Style="{StaticResource SmallLabelStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="الجدول الأسبوعي"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="أنشطتك ومواعيدك اليومية في مكان واحد."
                                       Foreground="#AAB4CA"
                                       Margin="0,10,0,16"/>
                            <Button Content="فتح الجدول الأسبوعي"
                                    Click="ScheduleButton_Click"
                                    Height="44"
                                    Background="#6878FF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- الجدول الأسبوعي -->
            <ScrollViewer x:Name="SchedulePage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30">

                    <TextBlock Text="الجدول الأسبوعي"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="اختار اليوم، وحدد النشاط، وعدّل الاسم والمواعيد ثم احفظ."
                               Foreground="#AAB4CA"
                               FontSize="14"
                               Margin="0,0,0,24"
                               TextWrapping="Wrap"/>

                    <!-- اختيار اليوم -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="اليوم"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <ComboBox x:Name="ScheduleDayComboBox"
                                      Height="42"
                                      Padding="8"
                                      SelectedIndex="0"
                                      SelectionChanged="ScheduleDayComboBox_SelectionChanged"
                                      Foreground="Black"
                                      Background="White"
                                      BorderBrush="#C7CDD8"
                                      ItemContainerStyle="{StaticResource LightComboBoxItemStyle}">
                                <ComboBoxItem Content="السبت" Tag="Saturday"/>
                                <ComboBoxItem Content="الأحد" Tag="Sunday"/>
                                <ComboBoxItem Content="الإثنين" Tag="Monday"/>
                                <ComboBoxItem Content="الثلاثاء" Tag="Tuesday"/>
                                <ComboBoxItem Content="الأربعاء" Tag="Wednesday"/>
                                <ComboBoxItem Content="الخميس" Tag="Thursday"/>
                                <ComboBoxItem Content="الجمعة" Tag="Friday"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- أنشطة اليوم -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="أنشطة اليوم"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="EmptyScheduleText"
                                       Text="لا توجد أنشطة لهذا اليوم."
                                       Foreground="#AAB4CA"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap"/>

                            <ListBox x:Name="ScheduleListBox"
                                     SelectionChanged="ScheduleListBox_SelectionChanged"
                                     DisplayMemberPath="DisplayText"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="14"
                                     MinHeight="40"
                                     MaxHeight="330">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="Background" Value="#1B2030"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#293052"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#242B40"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- تعديل النشاط -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="تعديل النشاط المحدد"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="اسم النشاط"
                                       Foreground="#AAB4CA"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="ActivityNameTextBox"
                                     Height="42"
                                     Padding="10"
                                     FontSize="14"
                                     Background="#151925"
                                     Foreground="White"
                                     BorderBrush="#303747"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="وقت البداية"
                                               Foreground="#AAB4CA"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="ساعة" Foreground="#AAB4CA" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="StartHourComboBox" Height="40" Background="White" Foreground="Black"
                                                      BorderBrush="#C7CDD8" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0">
                                            <TextBlock Text="دقيقة" Foreground="#AAB4CA" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="StartMinuteComboBox" Height="40" Background="White" Foreground="Black"
                                                      BorderBrush="#C7CDD8" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="صباح/مساء" Foreground="#AAB4CA" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="StartPeriodComboBox" Height="40" Background="White" Foreground="Black"
                                                      BorderBrush="#C7CDD8" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="وقت النهاية"
                                               Foreground="#AAB4CA"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="ساعة" Foreground="#AAB4CA" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="EndHourComboBox" Height="40" Background="White" Foreground="Black"
                                                      BorderBrush="#C7CDD8" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0">
                                            <TextBlock Text="دقيقة" Foreground="#AAB4CA" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="EndMinuteComboBox" Height="40" Background="White" Foreground="Black"
                                                      BorderBrush="#C7CDD8" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="صباح/مساء" Foreground="#AAB4CA" FontSize="11" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="EndPeriodComboBox" Height="40" Background="White" Foreground="Black"
                                                      BorderBrush="#C7CDD8" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="اختار الساعة والدقيقة والفترة لكل موعد. يتعامل الجدول تلقائيًا مع النشاط الذي ينتهي بعد منتصف الليل."
                                       Foreground="#AAB4CA"
                                       FontSize="12"
                                       Margin="0,10,0,18"
                                       TextWrapping="Wrap"/>

                            <Border x:Name="SleepSettingsPanel" Visibility="Collapsed"
                                    Background="#151925" BorderBrush="#303747" BorderThickness="1"
                                    CornerRadius="10" Padding="14" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="مهلة إعادة التشغيل في وضع النوم" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="يُطفأ الجهاز عند بداية النوم. إذا شغّلته أثناء فترة النوم، يُطفأ بعد انتهاء هذه المهلة."
                                                   Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="SleepGraceMinutesComboBox" Grid.Column="1" Height="38"
                                              VerticalAlignment="Center" Background="White" Foreground="Black"
                                              BorderBrush="#C7CDD8" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                    <Button Grid.Column="2" Content="حفظ المهلة" Click="SaveSleepGraceMinutesButton_Click"
                                            Height="38" Padding="12,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Background="White" Foreground="Black" BorderBrush="#C7CDD8" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="تطبيقات ومواقع النشاط"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="أضف التطبيقات والمواقع التي تريد منعها أثناء هذه الفترة. الحجب يقتصر على العناصر الموجودة في القوائم، والاستثناءات تظل متاحة دائمًا."
                                       Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Border Background="#151925" BorderBrush="#303747" BorderThickness="1"
                                    CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ما الذي تريد حظره؟" FontSize="16"
                                               FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="BlockApplicationsForActivityCheckBox"
                                                  Grid.Column="0" Content="حجب التطبيقات المحددة (تلقائي)"
                                                  Click="ActivityBlockOption_Click"
                                                  ToolTip="يتفعّل تلقائيًا عند إضافة تطبيق، ويختفي عندما تصبح القائمة فارغة. يمكنك إيقافه يدويًا مع إبقاء التطبيقات في القائمة."
                                                  Foreground="White" Margin="0,0,8,0"/>
                                        <CheckBox x:Name="BlockWebsitesForActivityCheckBox"
                                                  Grid.Column="1" Content="حجب المواقع المحددة (تلقائي)"
                                                  Click="ActivityBlockOption_Click"
                                                  ToolTip="يتفعّل تلقائيًا عند إضافة موقع، ويختفي عندما تصبح القائمة فارغة. يمكنك إيقافه يدويًا مع إبقاء المواقع في القائمة."
                                                  Foreground="White" Margin="8,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="نطاق الحجب: " Foreground="#AAB4CA"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox x:Name="BlockScopeComboBox" Width="240" Height="36"
                                                  SelectedIndex="1" Background="White" Foreground="Black"
                                                  BorderBrush="#C7CDD8"
                                                  ToolTip="حدد هل تنطبق خيارات الحجب وقوائم التطبيقات والمواقع على اليوم المحدد فقط أم على الفترة المطابقة طوال الأسبوع.">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Padding" Value="10,8"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Setter Property="Background" Value="#E7EAF0"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Setter Property="Background" Value="#DDE3EC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBoxItem Content="اليوم المحدد فقط" Tag="day"/>
                                            <ComboBoxItem Content="الفترة نفسها طوال الأسبوع" Tag="week"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="هذا الاختيار يحدد الأيام التي تُطبّق عليها خيارات الحجب وقوائم التطبيقات والمواقع. تعديل اسم النشاط ومواعيده له زران مستقلان أسفل الصفحة."
                                               Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="التطبيقات المحظورة في هذه الفترة (.exe)"
                                               Foreground="#AAB4CA"
                                               Margin="0,0,0,8"/>
                                    <ListBox x:Name="BlockedApplicationsListBox" MinHeight="110" MaxHeight="180"
                                             Background="#151925" Foreground="White" BorderBrush="#303747"
                                             SelectionMode="Single"/>
                                    <Button x:Name="AddBlockedApplicationButton" Content="إضافة تطبيق للحظر (.exe)"
                                            Click="AddBlockedApplicationButton_Click" Height="38" Margin="0,8,0,0"
                                            Background="#472B38" Foreground="#FFB5C2" BorderThickness="0" Cursor="Hand"/>
                                    <Button x:Name="RemoveBlockedApplicationButton" Content="إزالة التطبيق المحدد من الحظر"
                                            Click="RemoveBlockedApplicationButton_Click" Height="34" Margin="0,6,0,0"
                                            Background="#26394A" Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="المواقع المحظورة في هذه الفترة (النطاق والنطاقات الفرعية)"
                                               Foreground="#AAB4CA"
                                               Margin="0,0,0,8"/>
                                    <ListBox x:Name="BlockedWebsitesListBox" MinHeight="110" MaxHeight="180"
                                             Background="#151925" Foreground="White" BorderBrush="#303747"
                                             SelectionMode="Single"/>
                                    <TextBox x:Name="BlockedWebsiteTextBox"
                                             Height="38"
                                             Padding="8"
                                             Margin="0,8,0,0"
                                             Background="#151925"
                                             Foreground="White"
                                             BorderBrush="#303747"
                                             ToolTip="مثال: example.com"/>
                                    <Button x:Name="AddBlockedWebsiteButton" Content="إضافة الموقع إلى الحظر"
                                            Click="AddBlockedWebsiteButton_Click"
                                            Height="38"
                                            Margin="0,6,0,0"
                                            Background="#472B38"
                                            Foreground="#FFB5C2"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                    <Button x:Name="RemoveBlockedWebsiteButton" Content="إزالة الموقع المحدد من الحظر"
                                            Click="RemoveBlockedWebsiteButton_Click"
                                            Height="34"
                                            Margin="0,6,0,0"
                                            Background="#26394A"
                                            Foreground="#A9D8FF"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#151925" BorderBrush="#303747" BorderThickness="1"
                                    CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="حظر شامل مع استثناءات محددة" FontSize="16"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="فعّل الخيار المناسب لحظر كل المواقع أو التطبيقات أثناء هذه الفترة، مع إبقاء العناصر التي تضيفها هنا والاستثناءات العامة متاحة. عند تفعيله يتوقف أسلوب حظر العناصر المحددة لهذه الفئة."
                                               Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <CheckBox x:Name="BlockAllApplicationsExceptCheckBox"
                                                      Content="حظر كل التطبيقات ما عدا المختارة"
                                                      Click="ExceptPolicyCheckBox_Click" Foreground="White"
                                                      Margin="0,0,0,8"/>
                                            <ListBox x:Name="AllowedApplicationsDuringActivityListBox"
                                                     MinHeight="90" MaxHeight="140" Background="#151925"
                                                     Foreground="White" BorderBrush="#303747"/>
                                            <Button Content="اختيار تطبيق مسموح في هذه الفترة (.exe)"
                                                    Click="AddAllowedApplicationDuringActivityButton_Click"
                                                    Height="36" Margin="0,7,0,0" Background="#26394A"
                                                    Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="إزالة التطبيق المسموح المحدد"
                                                    Click="RemoveAllowedApplicationDuringActivityButton_Click"
                                                    Height="32" Margin="0,5,0,0" Background="#26394A"
                                                    Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <CheckBox x:Name="BlockAllWebsitesExceptCheckBox"
                                                      Content="حظر كل المواقع ما عدا النطاقات المختارة"
                                                      Click="ExceptPolicyCheckBox_Click" Foreground="White"
                                                      Margin="0,0,0,8"/>
                                            <ListBox x:Name="AllowedWebsitesDuringActivityListBox"
                                                     MinHeight="90" MaxHeight="140" Background="#151925"
                                                     Foreground="White" BorderBrush="#303747"/>
                                            <TextBox x:Name="AllowedWebsiteDuringActivityTextBox" Height="36"
                                                     Padding="8" Margin="0,7,0,0" Background="#151925"
                                                     Foreground="White" BorderBrush="#303747"
                                                     ToolTip="مثال: example.com"/>
                                            <Button Content="إضافة نطاق مسموح في هذه الفترة"
                                                    Click="AddAllowedWebsiteDuringActivityButton_Click"
                                                    Height="36" Margin="0,5,0,0" Background="#26394A"
                                                    Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="إزالة النطاق المسموح المحدد"
                                                    Click="RemoveAllowedWebsiteDuringActivityButton_Click"
                                                    Height="32" Margin="0,5,0,0" Background="#26394A"
                                                    Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="حفظ لهذا اليوم فقط"
                                        Tag="day"
                                        Click="SaveActivityButton_Click"
                                        Height="44"
                                        Margin="0,0,5,0"
                                        Background="White"
                                        Foreground="Black"
                                        BorderBrush="#C7CDD8"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        ToolTip="يحفظ اسم النشاط وموعده لليوم المحدد فقط."/>
                                <Button Grid.Column="1"
                                        Content="تطبيق التعديل على بقية الأسبوع"
                                        Tag="week"
                                        Click="SaveActivityButton_Click"
                                        Height="44"
                                        Margin="5,0,0,0"
                                        Background="White"
                                        Foreground="Black"
                                        BorderBrush="#C7CDD8"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        ToolTip="ينسخ اسم النشاط وموعده إلى النشاط المطابق في بقية أيام الأسبوع."/>
                            </Grid>

                            <Button Content="إضافة نشاط جديد (اختيار الأيام)"
                                    Click="AddActivityButton_Click"
                                    Height="42"
                                    Margin="0,10,0,0"
                                    Background="#26394A"
                                    Foreground="#A9D8FF"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button Content="حذف النشاط المحدد"
                                    Click="DeleteScheduleButton_Click"
                                    Height="42"
                                    Margin="0,10,0,0"
                                    Background="#472B38"
                                    Foreground="#FFB5C2"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button Content="حذف كل الفترات من الجدول الأسبوعي"
                                    Click="DeleteAllScheduleButton_Click"
                                    Height="42"
                                    Margin="0,8,0,0"
                                    Background="#5A2630"
                                    Foreground="#FFD7DC"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <TextBlock x:Name="ScheduleStatusText"
                                       Foreground="#70DFC5"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="التطبيقات والمواقع خارج قوائم الحظر تبقى متاحة. موافقتك مطلوبة أول مرة لتفعيل الحجب حسب الفترة."
                               Foreground="#AAB4CA"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>

            <!-- الاستثناءات العامة -->
            <ScrollViewer x:Name="ExceptionsPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30">
                    <TextBlock Text="الاستثناءات" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="كل تطبيق أو موقع تضيفه هنا يظل مباحًا في كل الأوضاع، حتى لو أُضيف إلى قائمة الحظر في فترة مجدولة. ما عدا ذلك لا يتأثر إلا إذا أضفته لقائمة حظر فترة."
                               Foreground="#AAB4CA" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="تطبيقات مباحة دائمًا" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ListBox x:Name="ExceptionApplicationsListBox" MinHeight="180" MaxHeight="320"
                                         Background="#151925" Foreground="White" BorderBrush="#303747"/>
                                <Button Content="اختيار ملف تطبيق (.exe)" Click="AddExceptionApplicationButton_Click"
                                        Height="38" Margin="0,10,0,0" Background="#26394A" Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="إزالة التطبيق المحدد" Click="RemoveExceptionApplicationButton_Click"
                                        Height="36" Margin="0,7,0,0" Background="#472B38" Foreground="#FFB5C2" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="مواقع مباحة دائمًا" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ListBox x:Name="ExceptionWebsitesListBox" MinHeight="180" MaxHeight="320"
                                         Background="#151925" Foreground="White" BorderBrush="#303747"/>
                                <TextBox x:Name="ExceptionWebsiteTextBox" Height="38" Padding="8" Margin="0,10,0,0"
                                         Background="#151925" Foreground="White" BorderBrush="#303747" ToolTip="مثال: example.com"/>
                                <Button Content="إضافة الموقع" Click="AddExceptionWebsiteButton_Click"
                                        Height="38" Margin="0,7,0,0" Background="#26394A" Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="إزالة الموقع المحدد" Click="RemoveExceptionWebsiteButton_Click"
                                        Height="36" Margin="0,7,0,0" Background="#472B38" Foreground="#FFB5C2" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ExceptionsStatusText" Foreground="#70DFC5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- الحجب الدائم للمواقع -->
            <ScrollViewer x:Name="PermanentWebsitesPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30">
                    <TextBlock Text="الحجب الدائم" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="المواقع هنا محجوبة طوال الوقت، حتى خارج الفترات المجدولة. لا يسمح بإزالة الموقع قبل مرور 15 يومًا من إضافته، ولا يوجد مفتاح لتعطيل الحجب الدائم."
                               Foreground="#AAB4CA" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="المواقع المحجوبة دائمًا" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox x:Name="PermanentWebsiteBlocksListBox" MinHeight="170" MaxHeight="320"
                                     DisplayMemberPath="DisplayText" SelectionChanged="PermanentWebsiteBlocksListBox_SelectionChanged"
                                     Background="#151925" Foreground="White" BorderBrush="#303747"/>
                            <TextBox x:Name="PermanentWebsiteTextBox" Height="40" Padding="8" Margin="0,10,0,0"
                                     Background="#151925" Foreground="White" BorderBrush="#303747"
                                     ToolTip="مثال: youtube.com أو https://facebook.com"/>
                            <Button Content="إضافة إلى الحجب الدائم" Click="AddPermanentWebsiteButton_Click"
                                    Height="40" Margin="0,8,0,0" Background="#472B38" Foreground="#FFB5C2"
                                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button x:Name="RemovePermanentWebsiteButton" Content="الإزالة متاحة بعد مرور 15 يومًا"
                                    Click="RemovePermanentWebsiteButton_Click" IsEnabled="False"
                                    Height="38" Margin="0,8,0,0" Background="#26394A" Foreground="#A9D8FF"
                                    BorderThickness="0" Cursor="Hand"/>
                            <TextBlock x:Name="PermanentWebsiteStatusText" Foreground="#70DFC5"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="تطبّق القائمة على متصفح يستخدم وكيل Windows. المتصفحات التي تتجاوز إعداد الوكيل أو خدمات DNS المشفرة قد تتجاوز الحجب."
                               Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>

            <!-- إعدادات عامة -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Background="#10131B"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30">
                    <TextBlock Text="الإعدادات" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="اختار طريقة تشغيل StudyGuard وخيارات حراسة الجهاز."
                               Foreground="#AAB4CA" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Border Background="#151925" BorderBrush="#303747" BorderThickness="1"
                            CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="StartupStatusText" Text="يبدأ StudyGuard تلقائيًا عند تسجيل الدخول إلى Windows."
                                       Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="يعمل البرنامج في الخلفية مع حساب Windows الحالي حتى يستمر تطبيق الجدول والحجب."
                                       Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- إعدادات الصلاة -->
            <ScrollViewer x:Name="PrayerSettingsPage" Visibility="Collapsed" Background="#10131B"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30">
                    <TextBlock Text="إعدادات الصلاة" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="اختار مدينتك ومدة السكون. عند حلول وقت الصلاة يظهر تنبيه، ثم يدخل الجهاز في السكون؛ وإذا أيقظته قبل انتهاء المدة سيعود للسكون تلقائيًا."
                               Foreground="#AAB4CA" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <Border Background="#151925" BorderBrush="#303747" BorderThickness="1"
                            CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="PrayerSleepEnabledCheckBox"
                                      Content="تفعيل تنبيهات الصلاة والسكون الإجباري"
                                      Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="تبدأ المدة من وقت الأذان. إذا فتحت اللابتوب قبل انتهائها، سيعود للسكون بعد استئناف StudyGuard عمله. الميزة تحتاج أن يظل StudyGuard يعمل في الخلفية."
                                       Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="المدينة في مصر" Foreground="#AAB4CA" Margin="0,0,0,7"/>
                                    <ComboBox x:Name="PrayerCityComboBox" Height="40" Background="White"
                                              Foreground="Black" BorderBrush="#C7CDD8"
                                              DisplayMemberPath="Name" SelectedValuePath="Key"
                                              ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="مدة السكون بعد الأذان" Foreground="#AAB4CA" Margin="0,0,0,7"/>
                                    <ComboBox x:Name="PrayerSleepDurationComboBox" Height="40" Background="White"
                                              Foreground="Black" BorderBrush="#C7CDD8"
                                              DisplayMemberPath="DisplayText" SelectedValuePath="Minutes"
                                              ItemContainerStyle="{StaticResource LightComboBoxItemStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="الصلوات التي يظهر عندها التنبيه ويدخل الجهاز في السكون" Foreground="White" FontWeight="SemiBold" Margin="0,18,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="PrayerFajrCheckBox" Content="الفجر" IsChecked="True" Foreground="White" Margin="0,0,22,8"/>
                                <CheckBox x:Name="PrayerDhuhrCheckBox" Content="الظهر" IsChecked="True" Foreground="White" Margin="0,0,22,8"/>
                                <CheckBox x:Name="PrayerAsrCheckBox" Content="العصر" IsChecked="True" Foreground="White" Margin="0,0,22,8"/>
                                <CheckBox x:Name="PrayerMaghribCheckBox" Content="المغرب" IsChecked="True" Foreground="White" Margin="0,0,22,8"/>
                                <CheckBox x:Name="PrayerIshaCheckBox" Content="العشاء" IsChecked="True" Foreground="White" Margin="0,0,0,8"/>
                            </WrapPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="حفظ إعدادات الصلاة"
                                        Click="SavePrayerSettingsButton_Click" Height="42" Margin="0,0,5,0"
                                        Background="#293052" Foreground="White" BorderBrush="#303747"
                                        FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Grid.Column="1" Content="تحديث مواقيت اليوم"
                                        Click="RefreshPrayerTimesButton_Click" Height="42" Margin="5,0,0,0"
                                        Background="#26394A" Foreground="#A9D8FF" BorderBrush="#303747"
                                        Cursor="Hand"/>
                            </Grid>
                            <TextBlock x:Name="PrayerTimesStatusText" Foreground="#AAB4CA"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <TextBlock x:Name="PrayerTimesSummaryText" Foreground="#F4F6FC"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="تُجلب المواقيت من خدمة AlAdhan وفق طريقة الهيئة المصرية العامة للمساحة، وتُحفظ نسخة اليوم محليًا. قد تختلف الدقائق عن جدول المسجد المحلي. اختار المدينة الأقرب لك."
                               Foreground="#AAB4CA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <Border x:Name="ScheduleNotificationBanner"
                Grid.Column="0"
                Panel.ZIndex="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20"
                Padding="16,12"
                MaxWidth="650"
                Background="#293052"
                BorderBrush="#6878FF"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button Content="إغلاق"
                        DockPanel.Dock="Left"
                        Click="DismissScheduleNotificationButton_Click"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        Background="#1B2030"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <TextBlock x:Name="ScheduleNotificationText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- القائمة الجانبية -->
        <Border Grid.Column="1"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#303747"
                BorderThickness="1,0,0,0"
                Padding="18,24">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,32">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#6878FF" Width="43" Height="43" CornerRadius="12">
                            <TextBlock Text="◇"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="StudyGuard" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="منظم وقتك" FontSize="11" Foreground="#AAB4CA" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="مساحة العمل" FontSize="11" Foreground="#727D95" Margin="12,0,0,12"/>

                    <Button x:Name="HomeButton" Click="HomeButton_Click" Style="{StaticResource NavButtonStyle}" Background="#293052" Foreground="White">
                        <TextBlock Text="⌂   الرئيسية" FontSize="14"/>
                    </Button>

                    <Button x:Name="ScheduleButton" Click="ScheduleButton_Click" Style="{StaticResource NavButtonStyle}">
                        <TextBlock Text="▦   الجدول الأسبوعي" FontSize="14"/>
                    </Button>

                    <Button x:Name="ExceptionsButton" Click="ExceptionsButton_Click" Style="{StaticResource NavButtonStyle}">
                        <TextBlock Text="◇   الاستثناءات" FontSize="14"/>
                    </Button>

                    <Button x:Name="PrayerSettingsButton" Click="PrayerSettingsButton_Click" Style="{StaticResource NavButtonStyle}">
                        <TextBlock Text="☾   إعدادات الصلاة" FontSize="14"/>
                    </Button>

                    <Button x:Name="PermanentWebsitesButton" Click="PermanentWebsitesButton_Click" Style="{StaticResource NavButtonStyle}">
                        <TextBlock Text="⊘   الحجب الدائم" FontSize="14"/>
                    </Button>

                    <Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource NavButtonStyle}">
                        <TextBlock Text="⚙   الإعدادات" FontSize="14"/>
                    </Button>

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Border Height="1" Background="#303747" Margin="0,0,0,14"/>
                    <TextBlock Text="الإصدار 0.1.0" Foreground="#727D95" FontSize="11" Margin="12,16,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
