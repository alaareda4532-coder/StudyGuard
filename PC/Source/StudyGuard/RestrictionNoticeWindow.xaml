<Window x:Class="StudyGuard.RestrictionNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="164" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" FlowDirection="RightToLeft" FontFamily="Tahoma"
        WindowStartupLocation="Manual">
    <Border Background="#171D2B" BorderBrush="#12CFE1" BorderThickness="1"
            CornerRadius="18" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="NoticeTitleText" Foreground="#F4F6FC" FontSize="17"
                           FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="NoticeBodyText" Foreground="#C2CBDD" FontSize="13"
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                <Button Content="تمام، هكمل" Click="DismissButton_Click" HorizontalAlignment="Left"
                        Padding="12,6" Margin="0,10,0,0" Background="#26394A"
                        Foreground="#A9D8FF" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
            <Image Grid.Column="1" Source="/StudyGuard;component/Gemini_Generated_Image_vyotp1vyotp1vyot.jfif"
                   Width="68" Height="68" Stretch="Uniform" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
